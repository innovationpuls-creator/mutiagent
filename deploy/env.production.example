APP_ENV=production
POSTGRES_MAINTENANCE_PASSWORD=generated-by-bootstrap
POSTGRES_APP_PASSWORD=generated-by-bootstrap
DATABASE_URL=postgresql://onetree_app:generated-by-bootstrap@postgres:5432/onetree
TARGET_DATABASE_URL=postgresql://onetree_maintenance:generated-by-bootstrap@postgres:5432/onetree
JWT_SECRET=generated-by-bootstrap
# Required by the backend, worker and ai-gateway; bootstrap generates them.
INTERNAL_API_TOKEN=generated-by-bootstrap
MODEL_SECRET_ENCRYPTION_KEY=generated-by-bootstrap
# AI_GATEWAY_URL (http://ai-gateway:8100) is fixed in compose.production.yml.

# Optional web search/fetch used by the knowledge-base and video-search agents (DeepSeek-compatible API).
WEB_SEARCH_BASE_URL=https://api.deepseek.com
WEB_SEARCH_API_KEY=
ALLOWED_ORIGINS=https://onetree.chat,https://www.onetree.chat,https://server-ipv4
PUBLIC_IPV4=server-ipv4
MAINTENANCE_BYPASS_TOKEN=generated-by-bootstrap
NGINX_CONFIG_MODE=bootstrap
VITE_ICP_BEIAN_NUMBER=粤ICP备2026100568号-1
LETSENCRYPT_EMAIL=fill-during-bootstrap
SMOKE_ACCOUNT=fill-during-bootstrap
SMOKE_PASSWORD=fill-during-bootstrap
