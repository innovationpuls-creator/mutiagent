{
	"name": "onetree-ai-gateway",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "OneTree TypeScript AI orchestration gateway (M1 foundation).",
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"dev": "tsx watch --env-file-if-exists=.env src/server.ts",
		"build": "tsc -p tsconfig.build.json",
		"start": "node --env-file-if-exists=.env dist/server.js",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"lint": "biome lint --error-on-warnings src test"
	},
	"dependencies": {
		"@earendil-works/pi-agent-core": "^1.6.1",
		"@earendil-works/pi-ai": "^1.6.1",
		"@earendil-works/pi-schema": "^1.6.1",
		"@hono/node-server": "^1.19.0",
		"@langchain/core": "^1.5.1",
		"@langchain/langgraph": "^1.7.5",
		"hono": "^4.9.0",
		"jose": "^6.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.9",
		"@types/node": "^22.10.0",
		"tsx": "^4.19.0",
		"typescript": "^5.7.2",
		"vitest": "^2.1.8"
	}
}
