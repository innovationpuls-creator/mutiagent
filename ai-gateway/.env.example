# Variable names are aligned with backend/.env.example. Values below are
# development-only; production refuses to start on missing/default secrets.
APP_ENV=development
PORT=8100
# Must equal the Python backend's JWT_SECRET (HS256).
JWT_SECRET=mutiagent-dev-secret-key-change-in-production
PYTHON_BACKEND_URL=http://127.0.0.1:8000
# Must equal the Python backend's INTERNAL_API_TOKEN (X-Internal-Token).
INTERNAL_API_TOKEN=mutiagent-dev-internal-token-change-in-production
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Optional platform web search/fetch (DeepSeek-compatible /v1/tools/search|fetch).
# Without it the knowledge-base agent tells the admin web search is unavailable.
WEB_SEARCH_BASE_URL=
WEB_SEARCH_API_KEY=
