{
	"$schema": "https://biomejs.dev/schemas/2.6.9/schema.json",
	"files": {
		"includes": [
			"src/**",
			"test/**",
			"!!**/dist"
		]
	},
	"formatter": {
		"enabled": false
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"suspicious": {
				"noExplicitAny": "off"
			},
			"style": {
				"noNonNullAssertion": "off"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"assist": {
		"enabled": false
	}
}
